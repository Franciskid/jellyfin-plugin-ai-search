<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Jellyfin.Plugin.AiSearch</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.AiSearch</AssemblyName>
    <Version>1.3.0.1</Version>
    <AssemblyVersion>1.3.0.1</AssemblyVersion>
    <FileVersion>1.3.0.1</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build against the earliest 12.x package (assembly version 12.0.0.0).
         Jellyfin's plugin loader rejects a plugin that references a HIGHER
         MediaBrowser.* assembly version than the running server ships, and the
         runtime version tracks the minor release (12.0.x server = 12.0.0.0,
         12.1.x server = 12.1.0.0). Referencing 12.0.0.0 is <= every 12.0.x and
         12.1.x server, so the one DLL loads across the whole 12.x line so far.
         Matches targetAbi. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\configPage.html" />
    <EmbeddedResource Include="Web\ai-search.js" />
  </ItemGroup>

</Project>
